HOST=127.0.0.1
PORT=3000
AUTO_REFRESH_SECONDS=60
TALABAT_DB_PATH=
RATINGS_API_URL=https://your-talabat-backend.vercel.app/api/ratings/latest
RATINGS_API_TOKEN=
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
AUTH_BOOTSTRAP_USERNAME=admin
AUTH_BOOTSTRAP_PASSWORD=replace-with-at-least-12-characters
AUTH_BOOTSTRAP_DISPLAY_NAME=Dashboard Administrator

# Independent Talabat trigger. Disabled until explicit cutover; never put GitHub token in cron-job.org.
TALABAT_SCHEDULER_ENABLED=0
TALABAT_SCHEDULER_SECRET=
TALABAT_GITHUB_DISPATCH_TOKEN=
# UTC activation boundary, e.g. 2026-10-15T00:00:00.000Z; only later slots are eligible.
TALABAT_SCHEDULER_START_AT=
